# Quant X Frontend — Environment Variables
# Copy to .env.local and fill in your values

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_WS_URL=ws://localhost:8000
API_URL=http://localhost:8000

# Origin of the standalone marketing/landing deployment (no trailing slash),
# e.g. https://quantx.app. /pricing, /proof, /legal/* , /terms and /privacy live
# THERE, not in this app — lib/marketing-url.ts turns them into absolute links.
# Leave unset for single-origin local dev and the links stay relative.
NEXT_PUBLIC_MARKETING_URL=

# Real company/broker logos via logo.dev (publishable key, client-safe). Optional:
# without it, favicons + initials monograms are used. Get a free key at logo.dev
NEXT_PUBLIC_LOGODEV_TOKEN=

# When 'true', the app is permitted to display NSE market-data (quotes/index/FII-DII/OI)
# from a licensed feed to all users. Leave unset until a real NSE display licence exists —
# otherwise raw NSE data is shown ONLY from each user's own connected broker feed (SEBI Path-A).
NEXT_PUBLIC_LICENSED_MARKET_DATA=
